# Django
SECRET_KEY=cambiar-por-clave-secreta-segura
DJANGO_SETTINGS_MODULE=config.settings.development

# Base de datos — PostgreSQL propio del proyecto
# Cada proyecto usa su propio puerto para no colisionar:
#   app-de-gestion  → 5432
#   wolf-crm        → 5433
#   (próximo)       → 5434
DB_NAME=wolf_crm
DB_USER=postgres
DB_PASSWORD=wolfcrm2025
DB_HOST=localhost
DB_PORT=5433

# Redis — propio del proyecto
# Cada proyecto usa su propio puerto:
#   app-de-gestion  → 6379
#   wolf-crm        → 6380
#   (próximo)       → 6381
REDIS_URL=redis://localhost:6380/0

# CORS
CORS_ALLOWED_ORIGINS=http://localhost:3001,http://127.0.0.1:3001

# SIFEN Paraguay
SIFEN_PRODUCTION=False
SIFEN_RUC=
SIFEN_CERT_PATH=
SIFEN_CERT_PASSWORD=

# Email (SendGrid en producción)
EMAIL_HOST=smtp.sendgrid.net
EMAIL_PORT=587
EMAIL_HOST_USER=apikey
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=noreply@wolfcrm.com.py
